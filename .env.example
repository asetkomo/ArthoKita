SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
APP_USERNAME=
APP_PASSWORD=
SESSION_SECRET=
# Opsional: login 2 langkah (TOTP). Kunci base32 dari Pengaturan → Verifikasi dua langkah. Kosong = nonaktif.
APP_TOTP_SECRET=
N8N_API_KEY=
AI_API_KEY=
AI_API_URL=
AI_MODEL=
# Model lebih murah untuk parsing chat (opsional)
AI_MODEL_TEXT=
# Bot Telegram (v7)
BOT_DEFAULT_ACCOUNT=
# Wajib untuk bot: chat_id Telegram yang diizinkan (pisahkan koma). Kosong = semua chat ditolak.
BOT_ALLOWED_CHAT_IDS=
BOT_TEXT_AI=auto
APP_TIMEZONE=Asia/Jakarta
FALLBACK_USD_IDR=
# Opsional: kirim email pengingat langsung via Resend (resend.com)
RESEND_API_KEY=
EMAIL_FROM=Dompetku <pengingat@domainanda.com>
EMAIL_TO=anda@email.com
# Opsional: monitoring error. Tanpa ini error tetap tercatat sebagai JSON satu baris di log Vercel.
# DSN proyek Sentry (Settings → Client Keys), dikirim lewat fetch tanpa SDK.
SENTRY_DSN=
# Hanya untuk developer lokal: ref project Supabase untuk `npm run gen:types` (bukan untuk Vercel).
SUPABASE_PROJECT_ID=
