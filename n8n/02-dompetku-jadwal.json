{
  "name": "Dompetku – Jadwal Laporan & Pengingat",
  "nodes": [
    {
      "parameters": {
        "content": "## ⏰ Dompetku — Schedules\nAll times use the workflow time zone **Asia/Jakarta** (change it in workflow Settings). Disable the triggers you don't need.\n\nEnv: `FINTRACK_URL`, `TELEGRAM_BOT_TOKEN`, `TELEGRAM_ADMIN_CHAT_ID`.\nCredential: Header Auth `x-api-key` (replace `REPLACE_ME` on all 4 HTTP nodes).\nReminders are only sent when something is due (≤3 days / overdue / budget almost used up). Reports use no AI tokens.",
        "height": 220,
        "width": 640,
        "color": "6"
      },
      "id": "dd231322-03fb-4048-9469-1d69c151f691",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "10939022-7de0-469f-8d72-4ea2b63ff5a9",
      "name": "Tiap hari 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FINTRACK_URL }}/api/public/n8n/reminders?days=3",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "2698668c-82f4-452f-819b-90f1a50e39de",
      "name": "Tagihan ≤ 3 hari",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Fintrack x-api-key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1877f40-d908-4826-8f5b-9e4d9fc680e7",
              "leftValue": "={{ $json.count }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7c298d44-0542-4be0-8687-2b7b9d4205a0",
      "name": "Ada tagihan?",
