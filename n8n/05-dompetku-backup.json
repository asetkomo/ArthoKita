{
  "name": "Dompetku – Backup Mingguan",
  "nodes": [
    {
      "parameters": {
        "content": "## 💾 Dompetku — Backup mingguan\nTiap Minggu 02:00 (Asia/Jakarta): `GET /api/public/n8n/backup` → simpan berkas JSON ke **Google Drive**.\n\nEnv: `FINTRACK_URL`. Credential: `Fintrack x-api-key` (Header Auth) + Google Drive OAuth2.\nGanti `REPLACE_ME_FOLDER_ID` di node *Upload ke Google Drive* dengan ID folder tujuan.\n\nAlternatif tanpa Google Drive: aktifkan node *Kirim via email* (lampiran JSON, butuh credential SMTP) lalu nonaktifkan node Drive.\nPulihkan lewat web: Pengaturan → **Pulihkan dari backup**.",
        "height": 300,
        "width": 680,
        "color": "6"
      },
      "id": "d5803101-14ac-4f5f-9032-4e1de3fdcf87",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                0
              ],
              "triggerAtHour": 2
            }
          ]
        }
      },
      "id": "f5e43082-5f44-4bfa-84af-c65fb31110d7",
      "name": "Tiap Minggu 02:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FINTRACK_URL }}/api/public/n8n/backup",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "eb73a686-048f-4696-ac83-d6f36a65a0e7",
      "name": "Ambil backup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Fintrack x-api-key"
        }
      }
    },
    {
      "parameters": {
        "name": "=dompetku-cadangan-{{ $now.setZone('Asia/Jakarta').toFormat('yyyy-MM-dd') }}.json",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive",
          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_ME_FOLDER_ID"
        },
        "options": {}
      },
      "id": "499beb48-35d9-4a86-8fa5-cbcf159632b7",
      "name": "Upload ke Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        480,
        -100
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.BACKUP_EMAIL_FROM }}",
        "toEmail": "={{ $env.BACKUP_EMAIL_TO }}",
        "subject": "=Backup Dompetku {{ $now.setZone('Asia/Jakarta').toFormat('yyyy-MM-dd') }}",
        "emailFormat": "text",
        "text": "Backup mingguan Dompetku terlampir. Pulihkan lewat Pengaturan → Pulihkan dari backup.",
        "options": {
          "attachments": "data"
        }
      },
      "id": "4d273b44-89f5-4240-a524-7e1599c403d7",
      "name": "Kirim via email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        480,
        100
      ],
      "disabled": true,
      "credentials": {
        "smtp": {
          "id": "REPLACE_ME",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Tiap Minggu 02:00": {
      "main": [
        [
          {
            "node": "Ambil backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ambil backup": {
      "main": [
        [
          {
            "node": "Upload ke Google Drive",
            "type": "main",
            "index": 0
          },
          {
            "node": "Kirim via email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "pinData": {},
  "active": false,
  "tags": []
}
